generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  description     String
  category        String
  listPrice       Float
  supplierPrice   Float
  vatRate         Float
  discountPercent Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, code])
}

model Settings {
  id            Int      @id @default(1)
  payoutPercent Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
